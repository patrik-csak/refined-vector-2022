{
	"name": "@patrik-csak/refined-vector-2022",
	"version": "0.0.0",
	"private": true,
	"description": "Refinements for Wikipedia's Vector 2022 skin",
	"license": "MIT",
	"repository": "github:patrik-csak/refined-vector-2022",
	"author": "Patrik Csak <p@trikcsak.com> (https://patrikcsak.com)",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"runtime": {
			"name": "node"
		},
		"packageManager": {
			"name": "npm",
			"version": "11.16 - 12"
		}
	},
	"scripts": {
		"docs": "md-magic --file readme.md && remark readme.md --output",
		"lint": "eslint && knip"
	},
	"devDependencies": {
		"eslint": "^10.2.0",
		"eslint-config-xo": "^7.0.0",
		"knip": "^6.17.1",
		"markdown-magic": "^4.8.0",
		"remark-cli": "^12.0.1",
		"remark-smartypants": "^3.0.2"
	},
	"allowScripts": {
		"es5-ext": false,
		"fsevents": false,
		"unrs-resolver": false
	}
}
