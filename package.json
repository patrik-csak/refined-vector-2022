{
  "name": "@patrik-csak/refined-vector-2022",
  "version": "0.0.0",
  "description": "Refinements for Wikipedia's Vector 2022 skin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrik-csak/refined-vector-2022.git"
  },
  "license": "MIT",
  "author": "Patrik Csak <p@trikcsak.com> (https://patrikcsak.com)",
  "type": "module",
  "scripts": {
    "docs": "md-magic --file readme.md && remark readme.md --output",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "concurrently npm:lint:check:*",
    "lint:check:eslint": "eslint",
    "lint:check:stylelint": "npm run stylelint",
    "lint:fix": "concurrently npm:lint:fix:*",
    "lint:fix:eslint": "eslint --fix",
    "lint:fix:stylelint": "npm run stylelint --fix",
    "quality:check": "concurrently npm:format:check npm:lint:check",
    "quality:fix": "npm run format:fix && npm run lint:fix",
    "stylelint": "stylelint '**/*.css'"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^10.2.0",
    "eslint-plugin-package-json": "^0.91.1",
    "markdown-magic": "^4.8.0",
    "prettier": "^3.8.1",
    "remark-cli": "^12.0.1",
    "remark-smartypants": "^3.0.2",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "unified": "^11.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.16"
    }
  },
  "allowScripts": {
    "es5-ext": false,
    "fsevents": false
  }
}
